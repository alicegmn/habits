{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2023"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"noEmit": true,
		"isolatedModules": true,
		"strict": true,
		"skipLibCheck": true,
		"types": ["node"]
	},
	"include": ["vite.config.ts", "eslint.config.mjs", "vitest.config.ts"],
	"exclude": ["src"]
}
